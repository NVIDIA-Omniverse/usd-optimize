#usda 1.0
(
    defaultPrim = "Part"
)

def Xform "Part"
{
    def Mesh "M1"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }
    def Mesh "M2"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }
}

# Inst's reference is internal to this file, so it targets this file's /Part.
def Xform "Nested"
{
    def Xform "Inst" (
        instanceable = true
        add references = </Part>
    )
    {
    }
}
