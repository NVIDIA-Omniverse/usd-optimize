#usda 1.0
(
    defaultPrim = "World"
)

# Inst1 and Inst2 both lead back to Thing, which a full-stage merge also reaches directly.
def Xform "World"
{
    def Xform "Thing"
    {
        def Mesh "M1"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }
        def Mesh "M2"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 1), (1, 0, 1), (0, 1, 1)]
        }
    }

    def Xform "Inst1" (
        instanceable = true
        add references = </World/Thing>
    )
    {
    }

    def Xform "Inst2" (
        instanceable = true
        add references = </World/Thing>
    )
    {
    }
}
