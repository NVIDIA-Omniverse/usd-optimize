#usda 1.0

def Xform "CapsuleRoles" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
{
    def Capsule "Visual" {}
    def Capsule "Collider" (prepend apiSchemas = ["PhysicsCollisionAPI"]) {}
}

def Xform "CapsulePair" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
{
    def Capsule "Left" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double radius = 0.5
        double height = 2
        uniform token axis = "Z"
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Capsule "Right" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        double radius = 0.5
        double height = 2
        uniform token axis = "Z"
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Xform "MaterialHierarchy" (prepend apiSchemas = ["PhysicsRigidBodyAPI"])
{
    def Mesh "Visual"
    {
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        uniform token subdivisionScheme = "none"
    }
    def Scope "Looks"
    {
        def Material "Paint"
        {
            def Shader "Shader" {}
        }
        def Material "Rubber"
        {
            def Shader "Shader" {}
        }
    }
}

