#usda 1.0

def Xform "CollectionBindings"
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "CollectionAPI:Left", "MaterialBindingAPI", "CollectionAPI:Right"]
    )
    {
        rel collection:Left:includes = [
            </CollectionBindings/Body/LeftA>,
            </CollectionBindings/Body/LeftB>,
        ]
        rel collection:Right:includes = [
            </CollectionBindings/Body/RightA>,
            </CollectionBindings/Body/RightB>,
        ]
        rel material:binding:collection:physics:Left = [
            </CollectionBindings/Body.collection:Left>,
            </CollectionBindings/Materials/Left>,
        ]
        rel material:binding:collection:physics:Right = [
            </CollectionBindings/Body.collection:Right>,
            </CollectionBindings/Materials/Right>,
        ]
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (1, 1, 1)
        float physics:mass = 1

        def Mesh "LeftA" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "LeftB" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "RightA" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "RightB" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    def "Materials"
    {
        def Material "Left" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
        }

        def Material "Right" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
        }
    }
}

def Xform "RotatedInertia"
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Mesh "A" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (1, 2, 3)
            float physics:mass = 1
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Mesh "B" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f physics:centerOfMass = (0, 1, 0)
            float3 physics:diagonalInertia = (1, 2, 3)
            float physics:mass = 1
            quatf physics:principalAxes = (0.70710677, 0, 0, 0.70710677)
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

def Xform "ScaledMass"
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        float3 xformOp:scale = (3, 3, 3)
        uniform token[] xformOpOrder = ["xformOp:scale"]

        def Mesh "A" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f physics:centerOfMass = (1, 0, 0)
            float3 physics:diagonalInertia = (1, 1, 1)
            float physics:mass = 1
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
            float3 xformOp:scale = (2, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Mesh "B" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f physics:centerOfMass = (1, 0, 0)
            float3 physics:diagonalInertia = (1, 1, 1)
            float physics:mass = 1
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

