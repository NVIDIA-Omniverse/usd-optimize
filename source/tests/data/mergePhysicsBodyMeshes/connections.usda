#usda 1.0

def Xform "KnownRelationships" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "A rigid body contains meshes with material bindings and relationships to a PhysicsScene."
)
{
    rel physics:simulationOwner = </KnownRelationships/Simulation>

    def PhysicsScene "Simulation"
    {
    }

    def Mesh "A" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </KnownRelationships/Materials/A>
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"

        def GeomSubset "Faces" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0]
            rel material:binding = </KnownRelationships/Materials/A>
        }
    }

    def "Materials"
    {
        def Material "A"
        {
        }

        def Material "B"
        {
        }
    }

    def Mesh "B" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        rel material:binding = </KnownRelationships/Materials/B>
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Collider" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        custom rel material:binding:physics = </KnownRelationships/Materials/B>
        rel physics:simulationOwner = </KnownRelationships/Simulation>
        point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0)]
        uniform token subdivisionScheme = "none"
    }
}

def Xform "InactiveSubset" (
    doc = "A prim outside the rigid body has a relationship targeting an inactive GeomSubset below a Mesh."
)
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Mesh "Referenced"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"

            def GeomSubset "Faces" (
                active = false
            )
            {
            }
        }
    }

    def "Outside"
    {
        custom rel faces = </InactiveSubset/Body/Referenced/Faces>
    }
}

def Xform "IncomingConnection" (
    doc = "An attribute outside the rigid body connects to the points attribute of the Connected mesh."
)
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Mesh "Connected"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "Visual"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    def "Outside"
    {
        custom point3f[] values
        point3f[] values.connect = </IncomingConnection/Body/Connected.points>
    }
}

def Xform "OutgoingConnection" (
    doc = "The Connected mesh's points attribute connects to an attribute outside the rigid body."
)
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Mesh "Connected"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            point3f[] points.connect = </OutgoingConnection/Outside.values>
            uniform token subdivisionScheme = "none"
        }

        def Mesh "Visual"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    def "Outside"
    {
        custom point3f[] values
    }
}

def Xform "ForwardedConnection" (
    doc = "A relationship outside the rigid body targets another relationship that targets a mesh's points attribute."
)
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Mesh "Connected"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "Visual"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    def "Outside"
    {
        custom rel forwarded = </ForwardedConnection/Outside.relay>
        custom rel relay = </ForwardedConnection/Body/Connected.points>
        custom point3f[] values
    }
}

def Xform "IncomingContainer" (
    doc = "A relationship outside the rigid body targets a Container Xform with two child meshes."
)
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Xform "Container"
        {
            def Mesh "A"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "B"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
                uniform token subdivisionScheme = "none"
            }
        }

        def Mesh "Visual"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    def "Outside"
    {
        custom rel dependency = </IncomingContainer/Body/Container>
    }
}

def Xform "OutgoingContainer" (
    doc = "A Container Xform with two child meshes has a relationship targeting a prim outside the rigid body."
)
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Xform "Container"
        {
            custom rel dependency = </OutgoingContainer/Outside>

            def Mesh "A"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "B"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
                uniform token subdivisionScheme = "none"
            }
        }

        def Mesh "Visual"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    def "Outside"
    {
    }
}

def Xform "InstanceConsumer" (
    doc = "A native instance inherits a reader with a relationship to geometry outside the instance."
)
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Mesh "Referenced"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
        }

        def Mesh "Visual"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    class "ReaderClass"
    {
        def "Reader"
        {
            custom rel geometry = </InstanceConsumer/Body/Referenced>
        }
    }

    def Xform "Consumer" (
        prepend inherits = </InstanceConsumer/ReaderClass>
        instanceable = true
    )
    {
    }
}

def Xform "SharedCollisionCollection" (
    doc = "Two guide colliders share a collision-group collection that also binds their physics material."
)
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:collection:physics:Colliders = [
            </SharedCollisionCollection/Group.collection:colliders>,
            </SharedCollisionCollection/Material>,
        ]
        float physics:mass = 1
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (1, 1, 1)

        def Mesh "A" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token purpose = "guide"
            uniform token subdivisionScheme = "none"
        }

        def Mesh "B" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
            uniform token purpose = "guide"
            uniform token subdivisionScheme = "none"
        }
    }

    def PhysicsCollisionGroup "Group"
    {
        rel collection:colliders:includes = [
            </SharedCollisionCollection/Body/A>,
            </SharedCollisionCollection/Body/B>,
        ]
        rel physics:filteredGroups = </SharedCollisionCollection/FilteredGroup>
    }

    def PhysicsCollisionGroup "FilteredGroup"
    {
    }

    def Material "Material" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
    }
}

