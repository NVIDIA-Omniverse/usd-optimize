def Xform "ExcludedHierarchies" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "A rigid body contains SkelRoot, Camera, Material, PointInstancer, inactive Mesh, and class Mesh prims."
)
