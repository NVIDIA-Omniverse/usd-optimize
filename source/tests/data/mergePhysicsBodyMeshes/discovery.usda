def Xform "ArticulationBoundary" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "A rigid body contains an articulation Xform and a fixed joint with PhysicsArticulationRootAPI."
)
{
    def Xform "Articulation" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Mesh "Visual"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }

    def PhysicsFixedJoint "WorldJoint" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        rel physics:body1 = </ArticulationBoundary>
    }

    def Mesh "Visual"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        uniform token subdivisionScheme = "none"
    }
}

def Xform "CandidateGeometry" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "A rigid body contains a mesh collider, a double-sided mesh, a subdivision mesh, and a Cube."
)
{
    def Mesh "Collider" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Visual"
    {
        uniform bool doubleSided = 1
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "OtherVisual"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0)]
        uniform token subdivisionScheme = "catmullClark"
    }

    def Cube "Shape"
    {
    }
}

