def Xform "IndexedPrimvars"
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Xform "Parts"
        {
            token[] primvars:label = ["part"] (
                interpolation = "constant"
            )

            def Mesh "A"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
                texCoord2f[] primvars:st = [(0, 0), (1, 1)] (
                    interpolation = "vertex"
                )
                int[] primvars:st:indices = [0, 1, 0]
                uniform token subdivisionScheme = "none"
            }

            def Mesh "B"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
                texCoord2f[] primvars:st = [(0, 0), (1, 1)] (
                    interpolation = "vertex"
                )
                int[] primvars:st:indices = [0, 1, 0]
                uniform token subdivisionScheme = "none"
            }
        }
    }
}

def Xform "JointColliderFrame"
{
    def Xform "Body" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    )
    {
        def Mesh "Target" (
            prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (1, 1, 1)
            float physics:mass = 1
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
            double3 xformOp:translate = (3, 4, 5)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Mesh "Visual"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
                uniform token subdivisionScheme = "none"
            }
        }
    }

    def PhysicsFixedJoint "Joint"
    {
        rel physics:body1 = </JointColliderFrame/Body/Target>
        point3f physics:localPos1 = (1, 2, 3)
    }
}

