#usda 1.0

def Xform "InheritedPrimvar" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
    doc = "Two independent meshes sit beside analytic shapes and a mesh that inherit an out-of-range primvar index."
)
{
    def Mesh "GoodA"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "GoodB"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Xform "Malformed"
    {
        float[] primvars:tint = [1] (
            interpolation = "constant"
        )
        int[] primvars:tint:indices = [2]

        def Cube "Cube"
        {
        }

        def Sphere "Sphere"
        {
        }

        def Mesh "Mesh"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0)]
            uniform token subdivisionScheme = "none"
        }
    }
}

def Xform "GuardedGeometry" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def Mesh "GoodA"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "GoodB"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "Guarded"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0)]
        uniform token subdivisionScheme = "none"
    }
}
