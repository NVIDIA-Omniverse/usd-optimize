#usda 1.0
(
    defaultPrim = "World"
)

# The instancer's prototype is a visible prim outside it, so a full-stage merge also reaches it directly, first.
def Xform "World"
{
    def Xform "Protos"
    {
        def Xform "A"
        {
            def Mesh "M1"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            }
            def Mesh "M2"
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 1), (1, 0, 1), (0, 1, 1)]
            }
        }
    }

    def PointInstancer "PI"
    {
        rel prototypes = </World/Protos/A>
        int[] protoIndices = [0, 0]
        point3f[] positions = [(5, 0, 0), (10, 0, 0)]
    }

    def Mesh "Other"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 5), (1, 0, 5), (0, 1, 5)]
    }
}
